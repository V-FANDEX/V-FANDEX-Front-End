    "serve": "^14.2.6",
    "three": "^0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@types/three": "^0.185.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
